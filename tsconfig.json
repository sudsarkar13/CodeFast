{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2018",
    "outDir": "out",
    "lib": ["ES2018", "DOM"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "types": ["node", "vscode", "mocha"]
  },
  "exclude": ["node_modules", ".vscode-test"],
  "include": [
    "src/**/*"
  ]
}